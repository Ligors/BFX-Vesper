# BFX VESPER — Environment Configuration
# Copy this file to .env and fill in your keys (or enter them directly in the app's Settings)

PORT=5000

# AI Configuration (BYOK - Bring Your Own Key)
# Free keys available at: https://console.groq.com / https://aistudio.google.com
AI_PRIMARY=groq
GROQ_API_KEY=
GEMINI_API_KEY=
GROQ_TEXT_MODEL=openai/gpt-oss-120b
GROQ_VISION_MODEL=qwen/qwen3.8-27b
GROQ_STT_MODEL=whisper-large-v3

# Optional: Telegram Guardian Alerts (create a bot via @BotFather on Telegram)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
GUARDIAN_NAME=Guardian

# Optional: WhatsApp Cloud API (developers.facebook.com)
WA_TOKEN=
WA_PHONE_NUMBER_ID=
WA_VERIFY_TOKEN=vesper-verify
WA_GRAPH_VERSION=v23.0
